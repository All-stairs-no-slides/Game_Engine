<UserControl x:Class="Game_Engine.User_controls.Collision_Menu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Game_Engine.User_controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="45*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="45*"/>
            <RowDefinition Height ="5*"/>
            <RowDefinition Height="45*"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Alias" FontSize="8"/>
        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Alias_prop, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="0" Grid.Column="1" Content="Collider type" FontSize="8"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Type_prop, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="2" Grid.Column="1" Content="Width" FontSize="8"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Width_prop, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="2" Content="Height" FontSize="8"/>
        <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding Height_prop, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="4" Grid.Column="1" Content="y offset" FontSize="8"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Y_offset_prop, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="4" Grid.Column="0" Content="x offset" FontSize="8"/>
        <TextBox Grid.Row="5" Grid.Column="0" Text="{Binding X_offset_prop, UpdateSourceTrigger=PropertyChanged}"/>


    </Grid>
</UserControl>
