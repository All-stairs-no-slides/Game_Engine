<UserControl x:Class="Game_Engine.User_controls.Instance_obj_display"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Game_Engine.User_controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             MouseMove="Instance_MouseMove"
             MouseLeftButtonDown="Instance_MouseLeftButtonDown">
    <Grid>
        <!-- Sprite images are added as children of Instance_canvas at runtime -->
        <Canvas x:Name="Instance_canvas" Background="Transparent" />
        <!-- Selection border is drawn on top; hidden by default -->
        <Border x:Name="Selection_border" BorderBrush="Transparent" BorderThickness="2" IsHitTestVisible="False" />
    </Grid>
</UserControl>
