<UserControl x:Class="Game_Engine.User_controls.Project_settings_Menu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Game_Engine.User_controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="45*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="45*"/>
            <RowDefinition Height ="5*"/>
            <RowDefinition Height="45*"/>
        </Grid.RowDefinitions>
    

        <Label Grid.Row="0" Content="Window Title" FontSize="8"/>
        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Alias_prop, UpdateSourceTrigger=PropertyChanged}"/>



        <Label Grid.Row="2" Grid.Column="1" Content="Window Width" FontSize="8"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Window_Width_prop, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Window Height" FontSize="8"/>
        <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding Window_Height_prop, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="4" Grid.Column="1" Content="Viewport Width" FontSize="8"/>
        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Viewport_Width_prop, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Viewport Height" FontSize="8"/>
        <TextBox Grid.Row="5" Grid.Column="0" Text="{Binding Viewport_Height_prop, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>
