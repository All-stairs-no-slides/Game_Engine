<Window x:Class="Game_Engine.PlaceViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Game_Engine"
        xmlns:Place_conts="clr-namespace:Game_Engine.User_controls.Places_Window_conts"
        mc:Ignorable="d"
        Title="PlaceViewWindow" Height="450" Width="800"
        AllowDrop="True"
        Drop="Place_Window_Drop"
        KeyDown="Key_pressed"
        Loaded="Place_Window_Loaded">
        
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*"/>
            <ColumnDefinition Width="75*"/>
        </Grid.ColumnDefinitions>

        <Place_conts:Place_Instances_List x:Name="Instance_list" Grid.Column="0" Loaded="Instance_list_Loaded"/>

        <!-- Place visual display canvas -->
        <Canvas x:Name="Place_display" Grid.Column="1"
                AllowDrop="True"
                Drop="Place_display_Drop"
                DragOver="Place_display_DragOver"
                Background="Transparent"
                ClipToBounds="True" />

        <Button Content="set as starting place" Grid.Column="1" Width="110" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Click="set_as_start" Panel.ZIndex="10" />
    </Grid>
</Window>
